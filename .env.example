# PDF MCQ Extractor - Environment Variables Configuration

# Optional: Google Gemini API Key for AI-assisted extraction on complex/disordered PDFs
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key alternative
# Obtain from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Next.js Port (Default: 3000)
PORT=3000
